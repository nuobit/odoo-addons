<odoo>
    <!-- window action documenttype2partner smart button -->
    <record id="partner_document_type_action_partner" model="ir.actions.act_window">
        <field name="name">Partner</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('document_ids.document_type_id', '=', active_id)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create the first Partner</p>
        </field>
    </record>

    <record id="partner_document_type_view_form" model="ir.ui.view">
        <field name="name">partner.document.type.view.form</field>
        <field name="model">partner.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type Form">
                <sheet>
                     <div name="button_box" class="oe_button_box">
                        <button
                            class="oe_stat_button"
                            name="%(partner_document_type_action_partner)d"
                            type="action"
                            icon="fa-users"
                            attrs="{'invisible': [('partner_count', '=', 0)]}"
                        >
                            <field
                                string="Partner(s)"
                                name="partner_count"
                                widget="statinfo"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name" />
                        </h1>
                    </div>
                    <group>
                        <field name="classification_ids" widget="many2many_tags" />
                        <field name="no_expiration" />
                        <field name="description" />
                        <field name="template_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partner_document_type_view_tree" model="ir.ui.view">
        <field name="name">partner.document.type.view.tree</field>
        <field name="model">partner.document.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="classification_ids" widget="many2many_tags" />
                <field name="description" />
                <field name="template_id" widget="many2one" />
                <field name="partner_count" string="Partner(s)" />
                <button
                    name="%(partner_document_type_action_partner)d"
                    type="action"
                    icon="fa-users"
                    title="Partner(s)"
                    attrs="{'invisible': [('partner_count', '=', 0)]}"
                />
            </tree>
        </field>
    </record>

    <record id="partner_document_type_list_action" model="ir.actions.act_window">
        <field name="name">Document types</field>
        <field name="res_model">partner.document.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create the first document type</p>
        </field>
    </record>

    <menuitem
        id="partner_document_type_menu"
        name="Document types"
        parent="partner_document.partner_document_menu"
        action="partner_document_type_list_action"
        sequence="20"
    />
</odoo>
