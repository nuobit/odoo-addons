<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.partner.document</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='contacts_setting_container']" position="inside">
                <div
                    class="col-xs-12 col-md-6 o_setting_box"
                    id="partner_document_request_data"
                >
                    <div class="o_setting_right_pane">
                        <label
                            for="partner_document_request_data_template_id"
                            string="Request Data Email Template"
                            class="o_form_label"
                        />
                        <span
                            class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            aria-label="Values set here are company-specific."
                            groups="base.group_multi_company"
                            role="img"
                        />
                        <div class="text-muted">
                            Template used by the request data button in the contact documents view.
                        </div>
                        <div class="content-group">
                            <div class="mt8">
                                <field
                                    name="partner_document_request_data_template_id"
                                    class="oe_inline"
                                    options="{'no_create': True}"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
