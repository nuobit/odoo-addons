<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="maintenance.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='maintenance']" position="inside">
                <block title="Maintenance Parameters">
                    <setting
                        help="Allow to edit the Request Date in Maintenance Requests."
                    >
                        <field name="maintenance_request_date_editable" />
                        <label for="maintenance_request_date_editable" />
                        <span
                            class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            aria-label="Values set here are company-specific."
                            groups="base.group_multi_company"
                            role="img"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
