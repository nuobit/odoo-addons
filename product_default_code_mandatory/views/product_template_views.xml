<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="product_template_variant_definition.product_template_only_form_view"
        />
        <field name="arch" type="xml">
            <field name="default_code" position="attributes">
                <attribute name="attrs">{'invisible': [('has_variants', '=', True)],
                  'required': [('has_variants', '=', False)]}</attribute>
            </field>
        </field>
    </record>
</odoo>
