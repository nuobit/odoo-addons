<odoo>
    <record id="sale_rental_view_kanban" model="ir.ui.view">
        <field name="name">sale.rental.view.kanban</field>
        <field name="model">sale.rental</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false">
                <field name="partner_id" />
                <field name="rented_product_id" />
                <field name="rental_qty" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="out_state" />
                <field name="in_state" />
                <field name="state" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="rented_product_id" />
                                        </strong>
                                    </div>
                                    <div style="font-size: 1.25rem;">
                                        <field
                                            name="state"
                                            widget="label_selection"
                                            options="{'classes': {
                                                'ordered': 'info',
                                                'out': 'warning',
                                                'sell_progress': 'warning',
                                                'sold': 'danger',
                                                'in': 'success',
                                                'cancel': 'default'
                                            }}"
                                        />
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="partner_id" />
                                    <div>
                                        <strong>
                                            <t t-out="record.rental_qty.value" />
                                        </strong>
                                        <span class="text-muted ms-1">
                                            ud.
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="text-muted">
                                            <i
                                                class="fa fa-calendar me-1"
                                                title="Rental period"
                                            />
                                            <t t-out="record.start_date.value" />
                                            <span class="mx-1">→</span>
                                            <t t-out="record.end_date.value" />
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <div
                                            data-tooltip-template="web.ImageZoomTooltip"
                                            t-att-data-tooltip-info="JSON.stringify({url: '/web/image/res.partner/' + record.partner_id.raw_value + '/image_1024'})"
                                            data-tooltip-position="top"
                                            data-tooltip-delay="300"
                                        >
                                            <img
                                                t-att-src="kanban_image('res.partner', 'avatar_128', record.partner_id.raw_value)"
                                                t-att-title="record.partner_id.value"
                                                t-att-alt="record.partner_id.value"
                                                class="rounded-circle"
                                                style="width: 40px; height: 40px; object-fit: cover;"
                                            />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sale_rental_view_calendar" model="ir.ui.view">
        <field name="name">sale.rental.view.calendar</field>
        <field name="model">sale.rental</field>
        <field name="arch" type="xml">
            <calendar
                string="Rentals"
                date_start="start_date"
                date_stop="end_date"
                color="state"
                create="false"
            >
                <field name="rented_product_id" />
                <field name="partner_id" />
                <field name="rental_qty" />
                <field name="state" />
            </calendar>
        </field>
    </record>

    <!-- Add filters and searchpanel to the rental search view -->
    <record id="sale_rental_search" model="ir.ui.view">
        <field name="name">sale.rental.search.inherit.sale_rental_extension</field>
        <field name="model">sale.rental</field>
        <field name="inherit_id" ref="sale_rental.sale_rental_search" />
        <field name="arch" type="xml">
            <filter name="in" position="after">
                <separator />
                <filter
                    name="today"
                    string="Today"
                    domain="['|', ('start_date', '=', context_today().strftime('%Y-%m-%d')), ('end_date', '=', context_today().strftime('%Y-%m-%d'))]"
                />
            </filter>
            <search position="inside">
                <searchpanel>
                    <field name="state" icon="fa-tag" select="one" />
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Add kanban to the rental positions action -->
    <record id="sale_rental.sale_rental_action" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,calendar,form,pivot</field>
    </record>
</odoo>
