#. module: mgmtsystem_document_master_folder
#: code:addons/mgmtsystem_document_master_folder/models/document_page.py:0
#, python-format
msgid ""
"Several categories are the master folder of %(menu)s: %(folders)s. Leave the"
" mark on only one per company."
msgstr ""
"Diverses categories són la carpeta mestra de %(menu)s: %(folders)s. Deixeu "
"la marca només en una per empresa."

#. module: mgmtsystem_document_master_folder
#: code:addons/mgmtsystem_document_master_folder/models/document_page.py:0
#, python-format
msgid ""
"The category \"%(folder)s\" is already the master folder of %(menu)s for the"
" company \"%(company)s\"."
msgstr ""
"La categoria \"%(folder)s\" ja és la carpeta mestra de %(menu)s de l'empresa "
"\"%(company)s\"."

#. module: mgmtsystem_document_master_folder
#: code:addons/mgmtsystem_document_master_folder/models/document_page.py:0
#, python-format
msgid ""
"The category \"%(folder)s\" is already the master folder of %(menu)s without"
" company."
msgstr ""
"La categoria \"%(folder)s\" ja és la carpeta mestra de %(menu)s sense "
"empresa."

#. module: mgmtsystem_document_master_folder
#: code:addons/mgmtsystem_document_master_folder/models/document_page.py:0
#, python-format
msgid ""
"The category \"%(folder)s\" is the master folder of %(menu)s. Clear its"
" \"Master Folder Of\" field before archiving it."
msgstr ""
"La categoria \"%(folder)s\" és la carpeta mestra de %(menu)s. Buideu el seu "
"camp \"Carpeta mestra de\" abans d'arxivar-la."

#. module: mgmtsystem_document_master_folder
#: code:addons/mgmtsystem_document_master_folder/models/document_page.py:0
#, python-format
msgid "The company \"%(company)s\" has no master folder of %(menu)s."
msgstr "L'empresa \"%(company)s\" no té carpeta mestra de %(menu)s."

#. module: mgmtsystem_document_master_folder
#: code:addons/mgmtsystem_document_master_folder/models/document_page.py:0
#, python-format
msgid "The page \"%s\" is not a category: only a category can be a master folder."
msgstr ""
"La pàgina \"%s\" no és una categoria: només una categoria pot ser carpeta "
"mestra."

