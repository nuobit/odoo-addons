#. module: mgmtsystem_document_master_folder
#: code:addons/mgmtsystem_document_master_folder/models/document_page.py:0
#, python-format
msgid ""
"Several categories are the master folder of %(menu)s: %(folders)s. Leave the"
" mark on only one per company."
msgstr ""
"Varias categorías son la carpeta maestra de %(menu)s: %(folders)s. Deje la "
"marca solo en una por empresa."

#. module: mgmtsystem_document_master_folder
#: code:addons/mgmtsystem_document_master_folder/models/document_page.py:0
#, python-format
msgid ""
"The category \"%(folder)s\" is already the master folder of %(menu)s for the"
" company \"%(company)s\"."
msgstr ""
"La categoría \"%(folder)s\" ya es la carpeta maestra de %(menu)s de la "
"empresa \"%(company)s\"."

#. module: mgmtsystem_document_master_folder
#: code:addons/mgmtsystem_document_master_folder/models/document_page.py:0
#, python-format
msgid ""
"The category \"%(folder)s\" is already the master folder of %(menu)s without"
" company."
msgstr ""
"La categoría \"%(folder)s\" ya es la carpeta maestra de %(menu)s sin "
"empresa."

#. module: mgmtsystem_document_master_folder
#: code:addons/mgmtsystem_document_master_folder/models/document_page.py:0
#, python-format
msgid "The company \"%(company)s\" has no master folder of %(menu)s."
msgstr "La empresa \"%(company)s\" no tiene carpeta maestra de %(menu)s."

#. module: mgmtsystem_document_master_folder
#: code:addons/mgmtsystem_document_master_folder/models/document_page.py:0
#, python-format
msgid "The page \"%s\" is not a category: only a category can be a master folder."
msgstr ""
"La página \"%s\" no es una categoría: solo una categoría puede ser carpeta "
"maestra."

