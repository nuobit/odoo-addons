#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid "Error connecting to WordPress: %s"
msgstr "Error al conectar amb WordPress: %s"

#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid ""
"Error decoding json WordPress response: %(message)s\n"
"%(response)s"
msgstr ""
"Error al descodificar la resposta json de WordPress: %(message)s\n"
"%(response)s"

#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid ""
"Error: '%(message)s'. Probably the %(resource)s has been removed from "
"WordPress. If it's the case, try to remove the binding of the %(model)s."
msgstr ""
"Error: '%(message)s'. Probablement el %(resource)s ha estat eliminat de "
"WordPress. Si és el cas, intenteu eliminar la vinculació del %(model)s."

#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid ""
"The backend %(backend)s cannot call WordPress until a WordPress backend is "
"chosen on it."
msgstr ""
"El backend %(backend)s no pot fer crides a WordPress fins que no s'hi triï "
"un backend de WordPress."

#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid "WordPress error %(code)s on %(resource)s: %(message)s"
msgstr "Error %(code)s de WordPress al recurs %(resource)s: %(message)s"

#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid "WordPress error on %(resource)s: %(answer)s"
msgstr "Error de WordPress al recurs %(resource)s: %(answer)s"

#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid ""
"WordPress refused the uploaded file: %(message)s Check that WordPress "
"accepts its format."
msgstr ""
"WordPress ha refusat el fitxer pujat: %(message)s Comproveu que WordPress "
"n'accepti el format."

#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid ""
"WordPress refused the uploaded file: %(message)s Check that WordPress "
"accepts its format. Request headers: %(headers)s"
msgstr ""
"WordPress ha refusat el fitxer pujat: %(message)s Comproveu que WordPress "
"n'accepti el format. Capçaleres de la petició: %(headers)s"

#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid "Wordpress not connected"
msgstr "WordPress no connectat"
