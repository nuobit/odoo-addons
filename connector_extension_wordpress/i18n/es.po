#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid "Error connecting to WordPress: %s"
msgstr "Error al conectar con WordPress: %s"

#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid ""
"Error decoding json WordPress response: %(message)s\n"
"%(response)s"
msgstr ""
"Error al decodificar la respuesta json de WordPress: %(message)s\n"
"%(response)s"

#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid "Error: %(message)s, Resource: %(resource)s"
msgstr "Error: %(message)s, Recurso: %(resource)s"

#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid ""
"Error: '%(message)s'. Probably the %(resource)s has been removed from "
"WordPress. If it's the case, try to remove the binding of the %(model)s."
msgstr ""
"Error: '%(message)s'. Probablemente el %(resource)s ha sido eliminado de "
"WordPress. Si es el caso, intente eliminar la vinculación del %(model)s."

#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid ""
"Error: '%(message)s'. Probably the image or document is uploaded with bad "
"format. Please, review on database: %(resource)s"
msgstr ""
"Error: '%(message)s'. Probablemente la imagen o el documento se ha subido "
"con un formato incorrecto. Por favor, revise en la base de datos: "
"%(resource)s"

#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid ""
"The backend %(backend)s cannot call WordPress until a WordPress backend is "
"chosen on it."
msgstr ""
"El backend %(backend)s no puede hacer llamadas a WordPress hasta que se le "
"elija un backend de WordPress."

#. module: connector_extension_wordpress
#. odoo-python
#: code:addons/connector_extension_wordpress/components/adapter.py:0
msgid "Wordpress not connected"
msgstr "WordPress no conectado"
