#. module: mail_dictation
#: model_terms:ir.ui.view,arch_db:mail_dictation.res_config_settings_view_form
msgid "<span class=\"o_form_label\">Voice Dictation</span>"
msgstr "<span class=\"o_form_label\">Dictado por voz</span>"

#. module: mail_dictation
#: model:ir.model,name:mail_dictation.model_res_config_settings
msgid "Config Settings"
msgstr "Ajustes de configuración"

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "Dictate"
msgstr "Dictar"

#. module: mail_dictation
#: model_terms:ir.ui.view,arch_db:mail_dictation.res_config_settings_view_form
msgid ""
"Dictate messages in the chat: a transcription service turns the voice into "
"text."
msgstr ""
"Dicte mensajes en el chat: un servicio de transcripción convierte la voz en "
"texto."

#. module: mail_dictation
#: model:ir.model,name:mail_dictation.model_mail_dictation
msgid "Dictation"
msgstr "Dictado"

#. module: mail_dictation
#. odoo-python
#: code:addons/mail_dictation/models/mail_dictation.py:0
#, python-format
msgid ""
"Dictation is not configured: an administrator must choose the transcription "
"service in Settings > Discuss."
msgstr ""
"El dictado no está configurado: un administrador debe elegir el servicio de "
"transcripción en Ajustes > Conversaciones."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid ""
"Dictation needs the microphone: allow it for this site in the browser and "
"try again."
msgstr ""
"El dictado necesita el micrófono: permítalo para este sitio en el navegador "
"y vuelva a intentarlo."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "No words were heard in the recording."
msgstr "No se ha oído ninguna palabra en la grabación."

#. module: mail_dictation
#. odoo-python
#: code:addons/mail_dictation/controllers/main.py:0
#, python-format
msgid "Only internal users can dictate."
msgstr "Solo los usuarios internos pueden dictar."

#. module: mail_dictation
#: model_terms:ir.ui.view,arch_db:mail_dictation.res_config_settings_view_form
msgid "Service"
msgstr "Servicio"

#. module: mail_dictation
#: model:ir.model.fields,help:mail_dictation.field_res_config_settings__mail_dictation_provider
msgid "Service that turns the dictated voice into text."
msgstr "Servicio que convierte la voz dictada en texto."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "Stop and transcribe (Esc discards the recording)"
msgstr "Detener y transcribir (Esc descarta la grabación)"

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "The conversation closed before the text arrived; nothing was inserted."
msgstr ""
"La conversación se cerró antes de que llegara el texto; no se ha insertado "
"nada."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "The dictated text was added to the conversation where you recorded it."
msgstr "El texto dictado se ha añadido a la conversación donde lo grabó."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid ""
"The microphone could not be started: check that one is connected and not in "
"use by another program."
msgstr ""
"No se ha podido iniciar el micrófono: compruebe que haya uno conectado y que"
" no lo esté usando otro programa."

#. module: mail_dictation
#. odoo-python
#: code:addons/mail_dictation/controllers/main.py:0
#, python-format
msgid "The recording is too long to be transcribed."
msgstr "La grabación es demasiado larga para transcribirla."

#. module: mail_dictation
#. odoo-python
#: code:addons/mail_dictation/controllers/main.py:0
#, python-format
msgid "The request carries no recording."
msgstr "La solicitud no lleva ninguna grabación."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "The server could not be reached. Try again in a moment."
msgstr ""
"No se ha podido conectar con el servidor. Vuelva a intentarlo en un momento."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid ""
"The server could not transcribe the recording: reload the page and try "
"again."
msgstr ""
"El servidor no ha podido transcribir la grabación: vuelva a cargar la página"
" e inténtelo de nuevo."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid ""
"This browser cannot record audio here: dictation needs a recent browser and "
"a secure (https) connection."
msgstr ""
"Este navegador no puede grabar audio aquí: el dictado necesita un navegador "
"reciente y una conexión segura (https)."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "Transcribing"
msgstr "Transcribiendo"

#. module: mail_dictation
#: model:ir.model.fields,field_description:mail_dictation.field_res_config_settings__mail_dictation_provider
msgid "Transcription Service"
msgstr "Servicio de transcripción"

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "Waiting for the microphone"
msgstr "Esperando el micrófono"
