#. module: mail_dictation
#: model_terms:ir.ui.view,arch_db:mail_dictation.res_config_settings_view_form
msgid "<span class=\"o_form_label\">Voice Dictation</span>"
msgstr "<span class=\"o_form_label\">Dictat per veu</span>"

#. module: mail_dictation
#: model:ir.model,name:mail_dictation.model_res_config_settings
msgid "Config Settings"
msgstr "Ajustos de configuració"

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "Dictate"
msgstr "Dictar"

#. module: mail_dictation
#: model_terms:ir.ui.view,arch_db:mail_dictation.res_config_settings_view_form
msgid ""
"Dictate messages in the chat: a transcription service turns the voice into "
"text."
msgstr ""
"Dicteu missatges al xat: un servei de transcripció converteix la veu en "
"text."

#. module: mail_dictation
#: model:ir.model,name:mail_dictation.model_mail_dictation
msgid "Dictation"
msgstr "Dictat"

#. module: mail_dictation
#. odoo-python
#: code:addons/mail_dictation/models/mail_dictation.py:0
#, python-format
msgid ""
"Dictation is not configured: an administrator must choose the transcription "
"service in Settings > Discuss."
msgstr ""
"El dictat no està configurat: un administrador ha de triar el servei de "
"transcripció a Configuració > Discussió."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid ""
"Dictation needs the microphone: allow it for this site in the browser and "
"try again."
msgstr ""
"El dictat necessita el micròfon: permeteu-lo per a aquest lloc al navegador "
"i torneu-ho a provar."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "No words were heard in the recording."
msgstr "No s'ha sentit cap paraula a l'enregistrament."

#. module: mail_dictation
#. odoo-python
#: code:addons/mail_dictation/controllers/main.py:0
#, python-format
msgid "Only internal users can dictate."
msgstr "Només els usuaris interns poden dictar."

#. module: mail_dictation
#: model_terms:ir.ui.view,arch_db:mail_dictation.res_config_settings_view_form
msgid "Service"
msgstr "Servei"

#. module: mail_dictation
#: model:ir.model.fields,help:mail_dictation.field_res_config_settings__mail_dictation_provider
msgid "Service that turns the dictated voice into text."
msgstr "Servei que converteix la veu dictada en text."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "Stop and transcribe (Esc discards the recording)"
msgstr "Aturar i transcriure (Esc descarta l'enregistrament)"

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "The conversation closed before the text arrived; nothing was inserted."
msgstr ""
"La conversa s'ha tancat abans que arribés el text; no s'ha inserit res."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "The dictated text was added to the conversation where you recorded it."
msgstr "El text dictat s'ha afegit a la conversa on l'heu enregistrat."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid ""
"The microphone could not be started: check that one is connected and not in "
"use by another program."
msgstr ""
"No s'ha pogut iniciar el micròfon: comproveu que n'hi hagi un de connectat i"
" que no l'estigui fent servir un altre programa."

#. module: mail_dictation
#. odoo-python
#: code:addons/mail_dictation/controllers/main.py:0
#, python-format
msgid "The recording is too long to be transcribed."
msgstr "L'enregistrament és massa llarg per transcriure'l."

#. module: mail_dictation
#. odoo-python
#: code:addons/mail_dictation/controllers/main.py:0
#, python-format
msgid "The request carries no recording."
msgstr "La sol·licitud no porta cap enregistrament."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "The server could not be reached. Try again in a moment."
msgstr ""
"No s'ha pogut connectar amb el servidor. Torneu-ho a provar d'aquí a un "
"moment."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid ""
"The server could not transcribe the recording: reload the page and try "
"again."
msgstr ""
"El servidor no ha pogut transcriure l'enregistrament: torneu a carregar la "
"pàgina i torneu-ho a provar."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid ""
"This browser cannot record audio here: dictation needs a recent browser and "
"a secure (https) connection."
msgstr ""
"Aquest navegador no pot enregistrar àudio aquí: el dictat necessita un "
"navegador recent i una connexió segura (https)."

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "Transcribing"
msgstr "S'està transcrivint"

#. module: mail_dictation
#: model:ir.model.fields,field_description:mail_dictation.field_res_config_settings__mail_dictation_provider
msgid "Transcription Service"
msgstr "Servei de transcripció"

#. module: mail_dictation
#. odoo-javascript
#: code:addons/mail_dictation/static/src/models/composer_view.esm.js:0
#, python-format
msgid "Waiting for the microphone"
msgstr "S'està esperant el micròfon"
