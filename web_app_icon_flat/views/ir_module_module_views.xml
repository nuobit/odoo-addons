<odoo>
    <record id="module_view_kanban" model="ir.ui.view">
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_view_kanban" />
        <field name="arch" type="xml">
            <field name="icon" position="after">
                <field name="display_icon" />
            </field>
            <xpath expr="//img[hasclass('oe_module_icon')]" position="attributes">
                <attribute name="t-attf-src">#{record.display_icon.value}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
