<odoo>
    <record id="hr_course_attendee_form_view" model="ir.ui.view">
        <field name="name">hr.course.attendee.form.inherit.duration</field>
        <field name="model">hr.course.attendee</field>
        <field name="inherit_id" ref="hr_course.hr_course_attendee_form_view" />
        <field name="arch" type="xml">
            <field name="course_end" position="after">
                <field name="duration" widget="float_time" />
            </field>
        </field>
    </record>

    <record id="hr_course_attendee_tree_employee_view" model="ir.ui.view">
        <field name="name">hr.course.attendee.tree.inherit.duration</field>
        <field name="model">hr.course.attendee</field>
        <field
            name="inherit_id"
            ref="hr_course.hr_course_attendee_tree_employee_view"
        />
        <field name="arch" type="xml">
            <field name="course_end" position="after">
                <field name="duration" widget="float_time" />
            </field>
        </field>
    </record>
</odoo>
