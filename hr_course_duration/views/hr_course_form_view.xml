<odoo>
    <record id="hr_course_form_view" model="ir.ui.view">
        <field name="name">hr.course.form.duration</field>
        <field name="model">hr.course</field>
        <field name="inherit_id" ref="hr_course.hr_course_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']/.." position="inside">
                <field name="duration" widget="float_time" />
            </xpath>
            <xpath expr="//tree/field[@name='cost']" position="before">
                <field name="duration" widget="float_time" />
            </xpath>
        </field>
    </record>
</odoo>
