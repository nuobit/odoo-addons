<odoo>

    <record id="view_mgmtsystem_verification_line_filter" model="ir.ui.view">
        <field
            name="name"
        >mgmtsystem.verification.line.filter - procedure filter</field>
        <field name="model">mgmtsystem.verification.line</field>
        <field
            name="inherit_id"
            ref="mgmtsystem_audit.view_mgmtsystem_verification_line_filter"
        />
        <field name="arch" type="xml">
            <field name="procedure_id" position="attributes">
                <attribute
                    name="domain"
                >[('is_mgmtsystem_document', '=', True)]</attribute>
            </field>
        </field>
    </record>

    <record id="view_mgmtsystem_verification_line_form" model="ir.ui.view">
        <field name="name">mgmtsystem.verification.line.form - procedure filter</field>
        <field name="model">mgmtsystem.verification.line</field>
        <field
            name="inherit_id"
            ref="mgmtsystem_audit.view_mgmtsystem_verification_line_form"
        />
        <field name="arch" type="xml">
            <field name="procedure_id" position="attributes">
                <attribute
                    name="domain"
                >[('is_mgmtsystem_document', '=', True)]</attribute>
            </field>
        </field>
    </record>

</odoo>
