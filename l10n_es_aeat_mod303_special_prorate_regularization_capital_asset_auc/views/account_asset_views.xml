<odoo>
    <record id="account_asset_view_form" model="ir.ui.view">
        <field name="model">account.asset</field>
        <field
            name="inherit_id"
            ref="account_asset_management.account_asset_view_form"
        />
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute
                    name="readonly"
                >state in ['open', 'close', 'removed', 'transferred']</attribute>
            </field>
            <field name="code" position="attributes">
                <attribute
                    name="readonly"
                >state in ['open', 'close', 'removed', 'transferred']</attribute>
            </field>
            <field name="profile_id" position="attributes">
                <attribute
                    name="readonly"
                >state in ['open', 'close', 'removed', 'transferred']</attribute>
            </field>
            <field name="partner_id" position="attributes">
                <attribute
                    name="readonly"
                >state in ['open', 'close', 'removed', 'transferred']</attribute>
            </field>
            <field name="method_time" position="attributes">
                <attribute
                    name="readonly"
                >state in ['open', 'close', 'removed', 'transferred']</attribute>
            </field>
            <field name="method_number" position="attributes">
                <attribute
                    name="readonly"
                >state in ['open', 'close', 'removed', 'transferred']</attribute>
            </field>
            <field name="method_period" position="attributes">
                <attribute
                    name="readonly"
                >state in ['open', 'close', 'removed', 'transferred']</attribute>
            </field>
            <field name="method_end" position="attributes">
                <attribute
                    name="readonly"
                >state in ['open', 'close', 'removed', 'transferred']</attribute>
            </field>
            <field name="method" position="attributes">
                <attribute
                    name="readonly"
                >state in ['open', 'close', 'removed', 'transferred']</attribute>
            </field>
            <field name="method_progress_factor" position="attributes">
                <attribute
                    name="readonly"
                >state in ['open', 'close', 'removed', 'transferred']</attribute>
            </field>
            <field name="prorata" position="attributes">
                <attribute
                    name="readonly"
                >method_time != 'year' or state in ['open', 'close', 'removed', 'transferred']</attribute>
            </field>
            <field name="depreciation_line_ids" position="attributes">
                <attribute
                    name="readonly"
                >state in ['open', 'close', 'removed', 'transferred']</attribute>
            </field>
        </field>
    </record>
</odoo>
