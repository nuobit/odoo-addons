<odoo>

    <!-- Not noupdate: updating document_page_procedure rewrites the domain and
         the context of its action, and this module, which depends on it, is
         updated right after it -->

    <record
        id="document_page_procedure.action_procedures"
        model="ir.actions.act_window"
    >
        <field
            name="domain"
        >[('parent_id.mgmtsystem_master_folder', '=', 'procedure')]</field>
        <field name="context">{'mgmtsystem_master_folder_menu': 'procedure'}</field>
    </record>

</odoo>
