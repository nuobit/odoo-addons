<odoo>
    <record id="account_analytic_line_rule_restricted" model="ir.rule">
        <field
            name="name"
        >Timesheets: restricted tasks only for the Restricted tasks group</field>
        <field name="model_id" ref="analytic.model_account_analytic_line" />
        <field
            name="domain_force"
        >[(1, '=', 1)] if user.has_group('project_task_restricted.group_restricted_task') else ['|', ('task_id', '=', False), ('task_id.restricted', '=', False)]</field>
    </record>
</odoo>
