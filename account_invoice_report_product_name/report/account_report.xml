<odoo>
    <template
        id="report_invoice_document"
        inherit_id="account.report_invoice_document"
        priority="99"
    >
        <xpath expr="//th[@name='th_description']" position="replace">
            <th name="th_description" class="text-start"><span>Product</span></th>
        </xpath>
        <xpath
            expr="//td[@name='account_invoice_line_name']/span[@t-field='line.name']"
            position="attributes"
        >
            <attribute name="t-if">line.product_id.name or line.name</attribute>
            <attribute name="t-field" />
            <attribute name="t-out">line.product_id.name or line.name</attribute>
        </xpath>
    </template>
</odoo>
