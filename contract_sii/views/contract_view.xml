<odoo>
    <record id="contract_contract_sale_form" model="ir.ui.view">
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contract_template_id']/.." position="after">
                <group
                    col="4"
                    string="SII Information"
                    invisible="sii_enabled == False"
                >
                    <group colspan="2">
                        <field name="sii_enabled" invisible="1" />
                        <field name="sii_registration_key_code" invisible="1" />
                        <field
                            name="sii_registration_key"
                            domain="[('type', '=', contract_type)]"
                            widget="selection"
                        />
                        <field
                            name="sii_property_location"
                            invisible="contract_type != 'sale' or sii_registration_key_code not in ('12','13')"
                            required="sii_registration_key_code in ('12','13') and contract_type == 'sale'"
                        />
                        <field
                            name="sii_property_cadastrial_code"
                            invisible="contract_type != 'sale' or sii_registration_key_code not in ('12','13')"
                            required="sii_registration_key_code in ('12','13') and sii_property_location in ('1','2') and contract_type == 'sale'"
                        />
                    </group>
                    <group colspan="2">
                        <field
                            name="sii_registration_key_additional1"
                            domain="[('type', '=', contract_type)]"
                            widget="selection"
                        />
                        <field
                            name="sii_registration_key_additional2"
                            domain="[('type', '=', contract_type)]"
                            widget="selection"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
