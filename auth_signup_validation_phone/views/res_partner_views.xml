<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="auth_signup_validation.res_partner_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='authentication']/span" position="after">
                <span attrs="{'invisible': [('signup_mobile_validated', '=', True)]}">
                    <i class="fa fa-phone text-danger" title="Mobile not verified" />
                </span>
                <span attrs="{'invisible': [('signup_mobile_validated', '=', False)]}">
                    <i class="fa fa-phone text-success" title="Mobile verified" />
                </span>
            </xpath>
            <field name="vat" position="after">
                <field name="signup_mobile_validated" widget="boolean_toggle" />
            </field>
        </field>
    </record>
</odoo>
