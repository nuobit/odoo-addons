<odoo>
    <template id="signup_fields" inherit_id="auth_signup.fields">
        <xpath expr="//div[@class='mb-3 field-login']" position="after">
            <div class="mb-3 field-mobile">
                <label for="name">Your Mobile</label>
                <input
                    type="text"
                    name="mobile"
                    t-att-value="mobile"
                    id="mobile"
                    class="form-control form-control-sm"
                    placeholder="+34600200500"
                    required="required"
                    t-att-readonly="'readonly' if only_passwords else None"
                />
            </div>
        </xpath>
    </template>
</odoo>
