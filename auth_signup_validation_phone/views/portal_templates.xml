<odoo>
    <template id="portal_contacta" inherit_id="portal.portal_layout">
        <xpath expr="//div[@t-field='user_id.partner_id']" position="attributes">
            <attribute name="t-options">
                {"widget": "contact", "fields": ["email", "phone", "mobile", "address", "name"]}
            </attribute>
        </xpath>
    </template>
    <template id="dims_portal_contact" inherit_id="portal.portal_my_details_fields">
        <xpath expr="//div[contains(@t-attf-class, 'phone')]" position="after">
            <div
                t-attf-class="mb-3 #{error.get('mobile') and 'o_has_error' or ''} col-xl-6"
            >
                <label class="col-form-label" for="mobile">Mobile</label>
                <input
                    type="tel"
                    name="mobile"
                    t-attf-class="form-control #{error.get('mobile') and 'is-invalid' or ''}"
                    t-att-value="mobile or partner.mobile"
                />
            </div>
        </xpath>
    </template>
</odoo>
