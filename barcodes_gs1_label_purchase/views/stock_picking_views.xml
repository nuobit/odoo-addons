<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field
            name="name"
        >stock.picking.form.inherit.barcodes_gs1_label_purchase</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='move_ids_without_package']/list/field[@name='picked']"
                position="before"
            >
                <field
                    name="purchase_uom_qty"
                    optional="show"
                    column_invisible="parent.picking_type_code != 'incoming'"
                    invisible="not is_dynamic_receipt"
                />
            </xpath>
        </field>
    </record>
</odoo>
