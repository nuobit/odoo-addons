<odoo>
    <record id="view_picking_type_form" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.force.product</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <field name="auto_show_reception_report" position="after">
                <group string="Force Final Product" invisible="code != 'mrp_operation'">
                    <field name="force_product_id" string="Product" />
                </group>
            </field>
        </field>
    </record>
</odoo>
