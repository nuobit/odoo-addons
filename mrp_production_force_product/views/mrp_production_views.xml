<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form.force.product.readonly</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <field name="product_id" position="before">
                <field name="has_forced_product" invisible="1" />
            </field>
            <field name="product_id" position="attributes">
                <attribute name="readonly">
                    has_forced_product
                </attribute>
            </field>
            <field name="product_qty" position="attributes">
                <attribute name="readonly">
                    state != 'draft' or has_forced_product
                </attribute>
            </field>
            <xpath
                expr="//field[@name='product_uom_id' and @groups='!uom.group_uom']"
                position="attributes"
            >
                <attribute name="readonly">
                    has_forced_product
                </attribute>
            </xpath>
            <xpath
                expr="//field[@name='product_uom_id' and @groups='uom.group_uom']"
                position="attributes"
            >
                <attribute name="readonly">
                    state != 'draft' or has_forced_product
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
