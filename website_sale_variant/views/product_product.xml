<odoo>
    <record id="product_product_view_form_easy_inherit_website_sale" model="ir.ui.view">
        <field name="model">product.product</field>
        <field
            name="inherit_id"
            ref="website_sale.product_product_view_form_easy_inherit_website_sale"
        />
        <field name="arch" type="xml">
            <sheet position="inside">
                <field name="sale_ok" invisible="1" />
                <notebook>
                    <page
                        name="shop"
                        string="eCommerce"
                        attrs="{'invisible': [('sale_ok','=',False)]}"
                    >
                        <group name="shop">
                            <group string="Shop">
                                <field
                                    name="variant_is_published"
                                    string="Is Published"
                                />
                            </group>
                        </group>
                    </page>
                </notebook>
            </sheet>
            <page name="shop" position="inside">
                <group name="product_variant_images" position="move" />
            </page>
        </field>
    </record>

    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <field name="website_sequence" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="public_categ_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="alternative_product_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="accessory_product_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="website_ribbon_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <group name="product_template_images" position="attributes">
                <attribute name="invisible">1</attribute>
            </group>
            <group name="product_template_images" position="after">
                <group name="product_variant_images" string="Extra Variant Media">
                    <field
                        name="product_variant_image_ids"
                        class="o_website_sale_image_list"
                        context="{'default_name': name}"
                        mode="kanban"
                        options="{'create_text':'Add a Media'}"
                        nolabel="1"
                    />
                </group>
            </group>
            <xpath
                expr="//page[@name='shop']/group[@name='shop']/group/field[@name='is_published']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//page[@name='shop']/group[@name='shop']/group/field[@name='is_published']"
                position="after"
            >
                <field name="variant_is_published" string="Is Published" />
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view" />
        <field name="arch" type="xml">
            <field name="is_published" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="is_published" position="after">
                <field
                    name="variant_is_published"
                    string="Is Published"
                    optional="hide"
                />
            </field>
        </field>
    </record>

    <record id="product_search_form_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='published']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='published']" position="after">
                <filter
                    name="variant_is_published"
                    string="Is Published"
                    domain="[('variant_is_published', '=', True)]"
                />
            </xpath>
        </field>
    </record>
</odoo>
