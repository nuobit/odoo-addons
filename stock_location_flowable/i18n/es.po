#. module: stock_location_flowable
#. odoo-python
#: code:addons/stock_location_flowable/models/mrp_production.py:0
msgid ""
"After completing the mixing order '%(order)s' at flowable location "
"'%(location)s', lot '%(lot)s' still has %(qty)s %(uom)s of stock. Expected 0"
" after merging all raw materials into lot '%(producing_lot)s'."
msgstr ""
"Después de completar la orden de mezcla '%(order)s' en la ubicación fluida "
"'%(location)s', el lote '%(lot)s' todavía tiene %(qty)s %(uom)s de stock. Se"
" esperaba 0 después de mezclar todas las materias primas en el lote "
"'%(producing_lot)s'."

#. module: stock_location_flowable
#. odoo-python
#: code:addons/stock_location_flowable/models/stock_location.py:0
msgid "All allowed products must be tracked by lot"
msgstr "Todos los productos permitidos deben ser rastreados por lote."

#. module: stock_location_flowable
#: model:ir.model.fields,field_description:stock_location_flowable.field_stock_location__flowable_allowed_product_ids
msgid "Allowed Products"
msgstr "Productos Permitidos"

#. module: stock_location_flowable
#. odoo-python
#: code:addons/stock_location_flowable/models/stock_location.py:0
msgid "Blocked"
msgstr "Bloqueado"

#. module: stock_location_flowable
#. odoo-python
#: code:addons/stock_location_flowable/models/mrp_production.py:0
msgid ""
"Cannot fully reserve the mixing order at flowable location '%(location)s'. "
"Raw materials are in state '%(states)s'."
msgstr ""
"No se puede reservar completamente la orden de mezcla en la ubicación fluida"
" '%(location)s'. Las materias primas están en estado '%(states)s'."

#. module: stock_location_flowable
#. odoo-python
#: code:addons/stock_location_flowable/models/mrp_production.py:0
msgid ""
"Cannot merge at flowable location '%(location)s' because there are reserved quantities. After the merge, the current lot(s) will have 0 stock and these reservations will become invalid.\n"
"\n"
"The following operations must be unreserved or completed first:\n"
"\n"
"%(details)s"
msgstr ""
"No se puede mezclar en la ubicación fluida '%(location)s' porque hay cantidades reservadas. Después de la mezcla, los lotes actuales tendrán 0 stock y estas reservas serán inválidas.\n"
"\n"
"Las siguientes operaciones deben ser liberadas o completadas primero:\n"
"\n"
"%(details)s"

#. module: stock_location_flowable
#. odoo-python
#: code:addons/stock_location_flowable/models/stock_picking.py:0
msgid ""
"Cannot receive multiple product/lot combinations (%(details)s) at flowable "
"location '%(location)s' in the same receipt. Each combination generates a "
"separate mixing order and the location is blocked after the first one. "
"Create a backorder to receive them in separate steps."
msgstr ""
"No se pueden recibir múltiples combinaciones de producto/lote (%(details)s) "
"en la ubicación de fluidos '%(location)s' en el mismo albarán. Cada "
"combinación genera una orden de mezcla separada y la ubicación queda "
"bloqueada después de la primera. Cree un albarán parcial para recibirlos en "
"pasos separados."

