<odoo noupdate="1">
    <!-- CUSTOMER -->
    <record model="ir.cron" id="cron_connector_oxigesti_spms_import_customer">
        <field name="name">Oxigesti SPMS Import Customers</field>
        <field name="active" eval="True" />
        <!-- Mandatory to define a explicit user on record from the frontend,
             DON'T USE admin (base.user_root) -->
        <!--field name="user_id" ref="<not base.user_root>"/-->
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="state">code</field>
        <field name="model_id" ref="model_oxigesti_spms_backend" />
        <field name="code">model.scheduler("action_import_partner_since")</field>
    </record>

