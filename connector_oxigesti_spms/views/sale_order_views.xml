<odoo>
    <record id="oxigesti_spms_view_order_form" model="ir.ui.view">
        <field name="name">sale.order.oxigesti.spms.connector.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page
                    string="Connector Oxigesti SPMS"
                    name="connector"
                    groups="connector.group_connector_manager"
                >
                    <group string="Oxigesti SPMS">
                        <field name="oxigesti_spms_bind_ids" colspan="2" nolabel="1" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
