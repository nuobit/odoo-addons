<odoo>
    <record id="spms_prescription_type_form_view" model="ir.ui.view">
        <field
            name="name"
        >spms.prescription.type.oxigesti.spms.connector.form.view</field>
        <field name="model">spms.prescription.type</field>
        <field name="inherit_id" ref="l10n_pt_spms.spms_prescription_type_form_view" />
        <field name="arch" type="xml">
            <xpath expr="/form/sheet" position="inside">
                <notebook>
                    <page
                        string="Connector Oxigesti SPMS"
                        name="connector"
                        groups="connector.group_connector_manager"
                    >
                    <group string="Oxigesti SPMS Bindings">
                        <field name="oxigesti_spms_bind_ids" colspan="2" nolabel="1" />
                    </group>
                </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
