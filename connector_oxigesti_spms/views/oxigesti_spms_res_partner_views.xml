<odoo>
    <record id="oxigesti_spms_res_partner_view_form" model="ir.ui.view">
        <field name="name">oxigesti.spms.res.partner.form</field>
        <field name="model">oxigesti.spms.res.partner</field>
        <field name="arch" type="xml">
            <form string="Oxigesti SPMS Partner">
                <sheet>
                    <group>
                        <field name="backend_id" />
                    </group>
                    <group>
                        <field name="odoo_id" />
                    </group>
                    <group>
                        <field name="oxigesti_spms_id" />
                    </group>
                    <group>
                        <field name="sync_date" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="oxigesti_spms_res_partner_view_tree" model="ir.ui.view">
        <field name="name">oxigesti.spms.res.partner.tree</field>
        <field name="model">oxigesti.spms.res.partner</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="backend_id" />
                <field name="odoo_id" />
                <field name="oxigesti_spms_id" />
                <field name="sync_date" />
                <button
                    name="resync_export"
                    type="object"
                    class="btn btn-info"
                    help="Resynchronize the export of the Customers to Oxigesti SPMS."
                    icon="fa-cloud-upload fa-lg"
                />
            </tree>
        </field>
    </record>
    <record id="oxigesti_spms_res_partner_view_search" model="ir.ui.view">
        <field name="name">oxigesti.spms.res.partner.search</field>
        <field name="model">oxigesti.spms.res.partner</field>
        <field name="arch" type="xml">
            <search string="Search Partner">
                <field name="odoo_id" filter_domain="[('odoo_id','ilike',self)]" />
                <field name="email" />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active','=',False)]"
                />
                <group expand="0" name="group_by" string="Group By">
                    <filter
                        name="group_backend"
                        string="Backend"
                        domain="[]"
                        context="{'group_by' : 'backend_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="oxigesti_spms_res_partner_action" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">oxigesti.spms.res.partner</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
