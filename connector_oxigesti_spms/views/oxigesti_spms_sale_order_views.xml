<odoo>
    <record id="oxigesti_spms_sale_order_view_form" model="ir.ui.view">
        <field name="name">oxigesti.spms.sale.order.view.form</field>
        <field name="model">oxigesti.spms.sale.order</field>
        <field name="arch" type="xml">
            <form string="Oxigesti SPMS Sale order">
                <group>
                    <field name="backend_id" />
                    <field name="odoo_id" />
                    <field name="oxigesti_spms_id" />
                    <field name="sync_date" readonly="1" />
                </group>
            </form>
        </field>
    </record>
    <record id="oxigesti_spms_sale_order_view_tree" model="ir.ui.view">
        <field name="name">oxigesti.spms.sale.order.view.tree</field>
        <field name="model">oxigesti.spms.sale.order</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="backend_id" />
                <field name="odoo_id" />
                <field name="oxigesti_spms_id" />
                <field name="sync_date" />
                <button
                    name="resync_export"
                    type="object"
                    class="btn btn-info"
                    help="Resynchronize the export of the Sale Orders to Oxigesti SPMS."
                    icon="fa-cloud-upload fa-lg"
                />
            </tree>
        </field>
    </record>
    <record id="oxigesti_spms_sale_order_action" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">oxigesti.spms.sale.order</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
