<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Vista formulario de plantilla -->
    <record id="document_template_view_form" model="ir.ui.view">
        <field name="name">document.template.view.form</field>
        <field name="model">document.template</field>
        <field name="arch" type="xml">
            <form string="Document Template">
                <header />
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name" />
                        </h1>
                    </div>
                    <group name="file_ids" string="Files">
                        <div
                            class="alert alert-info text-center"
                            role="alert"
                            colspan="2"
                        >
                            Remember: There must be a default file for the template if none exists for the language.
                        </div>
                        <field name="file_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field
                                    name="default"
                                    widget="boolean_toggle"
                                    options="{'autosave': False}"
                                />
                                <field name="lang_id" />
                                <field name="datas_fname" invisible="1" />
                                <field
                                    name="datas"
                                    filename="datas_fname"
                                    widget="binary"
                                />
                            </tree>
                            <form string="File">
                                <group>
                                    <field name="default" />
                                    <field name="lang_id" />
                                    <field name="datas_fname" />
                                    <field
                                        name="datas"
                                        filename="datas_fname"
                                        widget="binary"
                                    />
                                </group>
                            </form>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Vista árbol de plantilla -->
    <record id="document_template_view_tree" model="ir.ui.view">
        <field name="name">document.template.view.tree</field>
        <field name="model">document.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>
    <!-- Vista árbol de archivos -->
    <record id="document_template_file_view_tree" model="ir.ui.view">
        <field name="name">document.template.file.view.tree</field>
        <field name="model">document.template.file</field>
        <field name="arch" type="xml">
            <tree>
                <field name="template_id" />
                <field name="default" />
                <field name="lang_id" />
                <field name="datas_fname" />
            </tree>
        </field>
    </record>
    <!-- Vista formulario de archivo -->
    <record id="document_template_file_view_form" model="ir.ui.view">
        <field name="name">document.template.file.view.form</field>
        <field name="model">document.template.file</field>
        <field name="arch" type="xml">
            <form string="File">
                <group>
                    <field name="template_id" />
                    <field name="default" />
                    <field name="lang_id" />
                    <field name="datas_fname" />
                    <field name="datas" filename="datas_fname" widget="binary" />
                </group>
            </form>
        </field>
    </record>
</odoo>
