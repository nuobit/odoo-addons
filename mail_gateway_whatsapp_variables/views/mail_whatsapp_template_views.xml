<odoo>
    <record id="view_mail_whatsapp_template_form_inherit" model="ir.ui.view">
        <field name="name">view.mail.whatsapp.template.form.inherit</field>
        <field name="model">mail.whatsapp.template</field>
        <field
            name="inherit_id"
            ref="mail_gateway_whatsapp.view_mail_whatsapp_template_form"
        />
        <field name="arch" type="xml">
            <field name="body" position="after">
                <field
                    name="variable_ids"
                    attrs="{'invisible': [('state', '!=', 'draft')]}"
                    domain="[('section', '=', 'body')]"
                />
            </field>
        </field>
    </record>
</odoo>
