#. module: document_page_related
#: code:addons/document_page_related/models/document_page.py:0
#, python-format
msgid ""
"%s cannot be related to a category. Remove the categories from its list "
"first; some may be archived or hidden from you."
msgstr ""
"%s no es pot relacionar amb una categoria. Treu primer les categories de la "
"seva llista; algunes poden estar arxivades o ocultes per a tu."

#. module: document_page_related
#: code:addons/document_page_related/models/document_page.py:0
#, python-format
msgid ""
"%s has related documents, so it cannot be a category. Remove them first; "
"some may be archived or hidden from you."
msgstr ""
"%s té documents relacionats, de manera que no pot ser una categoria. Treu-"
"los primer; alguns poden estar arxivats o ocults per a tu."

#. module: document_page_related
#: code:addons/document_page_related/models/document_page.py:0
#, python-format
msgid ""
"%s is a related document of other documents, so it cannot be a category. "
"Remove it from their lists first; some of those documents may be archived or"
" hidden from you."
msgstr ""
"%s és un document relacionat d'altres documents, de manera que no pot ser "
"una categoria. Treu-lo primer de les seves llistes; alguns d'aquests "
"documents poden estar arxivats o ocults per a tu."

#. module: document_page_related
#: code:addons/document_page_related/models/document_page.py:0
#, python-format
msgid "A document cannot be related to itself: %s"
msgstr "Un document no pot estar relacionat amb si mateix: %s"

#. module: document_page_related
#: model_terms:ir.ui.view,arch_db:document_page_related.view_wiki_form
msgid "Open"
msgstr "Obrir"

