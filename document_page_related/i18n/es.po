#. module: document_page_related
#: code:addons/document_page_related/models/document_page.py:0
#, python-format
msgid ""
"%s cannot be related to a category. Remove the categories from its list "
"first; some may be archived or hidden from you."
msgstr ""
"%s no se puede relacionar con una categoría. Quita primero las categorías de"
" su lista; algunas pueden estar archivadas u ocultas para ti."

#. module: document_page_related
#: code:addons/document_page_related/models/document_page.py:0
#, python-format
msgid ""
"%s has related documents, so it cannot be a category. Remove them first; "
"some may be archived or hidden from you."
msgstr ""
"%s tiene documentos relacionados, por lo que no puede ser una categoría. "
"Quítalos primero; algunos pueden estar archivados u ocultos para ti."

#. module: document_page_related
#: code:addons/document_page_related/models/document_page.py:0
#, python-format
msgid ""
"%s is a related document of other documents, so it cannot be a category. "
"Remove it from their lists first; some of those documents may be archived or"
" hidden from you."
msgstr ""
"%s es un documento relacionado de otros documentos, por lo que no puede ser "
"una categoría. Quítalo primero de sus listas; algunos de esos documentos "
"pueden estar archivados u ocultos para ti."

#. module: document_page_related
#: code:addons/document_page_related/models/document_page.py:0
#, python-format
msgid "A document cannot be related to itself: %s"
msgstr "Un documento no puede estar relacionado consigo mismo: %s"

#. module: document_page_related
#: model_terms:ir.ui.view,arch_db:document_page_related.view_wiki_form
msgid "Open"
msgstr "Abrir"

