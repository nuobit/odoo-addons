<odoo>
    <record id="view_wiki_form" model="ir.ui.view">
        <field name="name">document.page.form.inherit.related</field>
        <field name="model">document.page</field>
        <field name="inherit_id" ref="document_page.view_wiki_form" />
        <!-- applied after the views that add their tab with the default priority -->
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    name="related_documents"
                    string="Related Documents"
                    attrs="{'invisible': [('type', '!=', 'content')]}"
                >
                    <field
                        name="related_page_ids"
                        context="{'tree_view_ref': 'document_page.view_wiki_tree', 'search_view_ref': 'document_page.view_wiki_filter'}"
                        options="{'no_create': True}"
                    >
                        <tree>
                            <field name="name" />
                            <field name="parent_id" />
                            <!-- an icon only: in a list row the string would be shown beside it, the title is its tooltip -->
                            <button
                                name="action_open_page"
                                type="object"
                                icon="fa-arrow-right"
                                title="Open"
                            />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
