<odoo>
    <record id="document_page_history_recipient_download_tree" model="ir.ui.view">
        <field name="name">document.page.history.recipient.download.tree</field>
        <field name="model">document.page.history.recipient.download</field>
        <field name="arch" type="xml">
            <tree>
                <field name="download_date" />
                <field name="user_id" />
                <field name="attachment_id" />
                <field name="ip_address" optional="hide" />
            </tree>
        </field>
    </record>
    <record id="document_page_history_recipient_download_form" model="ir.ui.view">
        <field name="name">document.page.history.recipient.download.form</field>
        <field name="model">document.page.history.recipient.download</field>
        <field name="arch" type="xml">
            <form string="Download">
                <sheet>
                    <group>
                        <group>
                            <field name="download_date" />
                            <field name="user_id" />
                            <field name="attachment_id" />
                        </group>
                        <group>
                            <field name="ip_address" />
                            <field name="user_agent" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_wiki_form_distribution_download_log" model="ir.ui.view">
        <field name="name">document.page.form.distribution.download.log</field>
        <field name="model">document.page</field>
        <field
            name="inherit_id"
            ref="document_page_distribution.view_wiki_form_distribution"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='current_recipient_ids']/tree/field[@name='last_notification_status']"
                position="after"
            >
                <field name="downloaded" />
                <field name="download_count" optional="hide" />
                <field name="last_download_date" optional="hide" />
            </xpath>
            <xpath
                expr="//field[@name='current_recipient_ids']/tree/button[@name='action_open_sends']"
                position="after"
            >
                <button
                    name="action_open_downloads"
                    type="object"
                    icon="fa-download"
                    string="Downloads"
                />
            </xpath>
        </field>
    </record>
</odoo>
