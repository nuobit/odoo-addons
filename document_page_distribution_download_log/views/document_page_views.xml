<odoo>
    <record id="view_wiki_form_distribution_download_log" model="ir.ui.view">
        <field name="name">document.page.form.distribution.download.log</field>
        <field name="model">document.page</field>
        <field
            name="inherit_id"
            ref="document_page_distribution.view_wiki_form_distribution"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='history_ids']/tree/field[@name='distribution_summary']"
                position="after"
            >
                <field name="download_summary" string="Downloads" />
            </xpath>
            <xpath
                expr="//field[@name='current_recipient_ids']/tree/field[@name='last_successful_sent_date']"
                position="after"
            >
                <field name="downloaded" />
                <field name="download_count" optional="hide" />
                <field name="last_download_date" optional="hide" />
            </xpath>
            <xpath
                expr="//field[@name='current_recipient_ids']/tree/button[@name='action_open_sends']"
                position="after"
            >
                <button
                    name="action_open_downloads"
                    type="object"
                    icon="fa-download"
                    string="Downloads"
                />
            </xpath>
        </field>
    </record>
</odoo>
