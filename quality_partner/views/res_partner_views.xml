<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">quality.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <field name="supplier_rank" invisible="1" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
                    string="Quality"
                    invisible="supplier_rank &lt;= 0 and is_company"
                    groups="quality_partner.quality_partner_group_guest"
                >
                    <notebook>
                        <page string="Supplier classification">
                            <group>
                                <field
                                    name="quality_classification_id"
                                    required="not quality_document_ids"
                                />
                            </group>
                            <group string="Documents">
                                <field
                                    name="quality_document_ids"
                                    nolabel="1"
                                    colspan="2"
                                />
                            </group>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
