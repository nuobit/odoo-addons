<odoo>
    <record id="stock_production_lot_view_tree" model="ir.ui.view">
        <field name="name">stock_production_lot_view_tree_inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button
                        name="print_barcode_label_template_wizard"
                        string="Print Barcodes with Template"
                        groups="stock.group_stock_manager"
                        type="object"
                    />
                </header>
            </xpath>
        </field>
    </record>

    <record id="stock_production_lot_view_form" model="ir.ui.view">
        <field name="name">stock_production_lot_view_form_inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="print_barcode_label_template_wizard"
                    string="Print Barcodes with Template"
                    groups="stock.group_stock_manager"
                    type="object"
                />
            </xpath>
        </field>
    </record>
</odoo>
