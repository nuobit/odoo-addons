<odoo>
    <template id="report_assets_common" inherit_id="web.report_assets_common">
        <xpath expr="." position="inside">
            <link
                href="/barcode_label_template/static/src/scss/styles.scss"
                rel="stylesheet"
                type="text/scss"
            />
        </xpath>
    </template>
    <template id="layout_gs1productdata">
        <div class="barcode-data">
            <div class="text-center barcode-data-row">
                <div>
                    <p class="font-size75" t-field="barcode['product'].default_code" />
                    <p class="font-size50" t-field="barcode['product'].name" />
                </div>
            </div>
        </div>
    </template>
    <template id="report_label_template_field">
        <t t-foreach="field" t-as="f">
            <div
                t-att-style="'position: absolute; top: %dmm; left: %dmm;' % (f['position_y'], f['position_x'])"
            >
                <div t-att-style="'width: %dmm;' % f['width']">
                    <span t-esc="f['value']" />
                </div>
            </div>
        </t>
    </template>
    <template id="report_label_template_barcode">
        <t t-foreach="datas" t-as="data">
            <t t-set="barcode" t-value="data['barcodes_data']" />
            <t t-set="field" t-value="data['fields_data']" />
            <div class="page-container">
                <t t-call="barcode_label_template.report_label_template_field" />
                <t t-if="barcode">
                    <div
                        t-att-style="'position: absolute; top: %dmm; left: %dmm;' % (barcode['position_y'], barcode['position_x'])"
                    >
                        <div
                            class="label-container"
                            t-att-style="'width: %dmm;' % barcode['width']"
                        >
                            <div class="barcode-row">
                                <div>
                                    <img
                                        t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;height=%s' % (barcode['type'], barcode['string'], 100)"
                                        t-attf-class="bgp-img"
                                    />
                                </div>
                                <div class="barcode-details">
                                    <ul class="list-unstyled">
                                        <t
                                            t-foreach="barcode['values'].items()"
                                            t-as="bv"
                                        >
                                            <li t-esc="'(%s)%s' % bv" />
                                        </t>
                                    </ul>
                                </div>
                            </div>
                            <t t-call="barcode_label_template.layout_gs1productdata" />
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>
    <template id="report_label_template">
        <t t-call="web.basic_layout">
            <t t-call="barcode_label_template.report_label_template_barcode" />
        </t>
    </template>
</odoo>
