<odoo>
    <record id="account_analytic_account_recurring_form_form" model="ir.ui.view">
        <field name="name">account.analytic.account.recurring.form.form</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='contract_line_fixed_ids']/list/field[@name='price_subtotal']"
                position="before"
            >
                <field
                    name="tax_ids"
                    domain="[('type_tax_use', '=', parent.contract_type),('company_id','=',parent.company_id)]"
                    context="{}"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                />
            </xpath>
            <xpath
                expr="//field[@name='contract_line_ids']/list/field[@name='price_subtotal']"
                position="before"
            >
                <field
                    name="tax_ids"
                    domain="[('type_tax_use', '=', parent.contract_type),('company_id','=',parent.company_id)]"
                    context="{}"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>

    <record id="contract_line_tree_view" model="ir.ui.view">
        <field name="name">contract.line.list.view</field>
        <field name="model">contract.line</field>
        <field name="inherit_id" ref="contract.contract_line_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_subtotal']" position="before">
                <field
                    name="tax_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>
    <record id="contract_line_form_view" model="ir.ui.view">
        <field name="name">contract.line.form.view</field>
        <field name="model">contract.line</field>
        <field name="inherit_id" ref="contract.contract_line_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='discount']" position="after">
                <field
                    colspan="4"
                    name="tax_ids"
                    domain="[('type_tax_use', '=', parent.contract_type),('company_id','=',parent.company_id)]"
                    context="{}"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
