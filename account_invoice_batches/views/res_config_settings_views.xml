<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="after">
                <block title="Invoice batches" id="invoice_batches_settings_block">
                    <setting
                        id="weight_uom_setting"
                        company_dependent="1"
                        string="Default email template"
                        help="If empty, you're gonna need to select a template on batch processing
                                dialog."
                    >
                        <field
                            name="invoice_batch_sending_email_template_id"
                            class="o_light_label"
                        />
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
