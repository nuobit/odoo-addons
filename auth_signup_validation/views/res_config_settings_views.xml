<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="auth_signup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='enable_password_reset']" position='after'>
                <div class="col-12 col-lg-6 o_setting_box" id="auth_signup_method">
                    <div class="o_setting_left_pane" />
                    <div class="o_setting_right_pane">
                        <label for="auth_signup_method" />
                        <div class="text-muted">
                            Choose the authentication method for signup.
                        </div>
                        <div class="mt8">
                            <field
                                name="auth_signup_method"
                                class="o_light_label"
                                widget="radio"
                                options="{'horizontal': true}"
                                required="True"
                            />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
