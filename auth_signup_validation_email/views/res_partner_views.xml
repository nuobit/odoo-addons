<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="auth_signup_validation.res_partner_view_form" />
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="signup_email_validated" widget="boolean_toggle" />
            </field>
            <xpath expr="//div[@id='authentication']/span" position="after">
                <span attrs="{'invisible': [('signup_email_validated', '=', True)]}">
                    <i class="fa fa-envelope text-danger" title="Email not verified" />
                </span>
                <span attrs="{'invisible': [('signup_email_validated', '=', False)]}">
                    <i class="fa fa-envelope text-success" title="Email verified" />
                </span>
            </xpath>
        </field>
    </record>
</odoo>
