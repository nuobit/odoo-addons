#. module: project_task_restricted
#: code:addons/project_task_restricted/models/project_task.py:0
#: model:res.groups,name:project_task_restricted.group_restricted_task
#, python-format
msgid "Restricted tasks"
msgstr "Tareas restringidas"

#. module: project_task_restricted
#: code:addons/project_task_restricted/models/project_task.py:0
#, python-format
msgid ""
"Taken off this restricted task after leaving the Restricted tasks group: "
"%(users)s."
msgstr ""
"Se ha quitado de esta tarea restringida a quien ha dejado el grupo Tareas "
"restringidas: %(users)s."

#. module: project_task_restricted
#: model:ir.model.fields,field_description:project_task_restricted.field_project_task_burndown_chart_report__task_id
msgid "Task"
msgstr "Tarea"

#. module: project_task_restricted
#: model:res.groups,comment:project_task_restricted.group_restricted_task
msgid ""
"Tasks marked Restricted are hidden from everyone outside this group. Only "
"its members can mark or unmark a task."
msgstr ""
"Las tareas marcadas como Restricted quedan ocultas para todos los que no "
"pertenezcan a este grupo. Solo sus miembros pueden marcar o desmarcar una "
"tarea."

#. module: project_task_restricted
#: code:addons/project_task_restricted/models/project_project.py:0
#, python-format
msgid ""
"You cannot delete a project that contains restricted tasks. You can archive "
"it instead."
msgstr ""
"No puede eliminar un proyecto que contiene tareas restringidas. En su lugar,"
" puede archivarlo."
