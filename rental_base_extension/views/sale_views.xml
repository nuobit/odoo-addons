<odoo>
    <!-- Move Rental Positions to top-level menu and make it visible -->
    <record id="rental_base.menu_rental_positions" model="ir.ui.menu">
        <field name="parent_id" ref="rental_base.menu_rental_root" />
        <field name="sequence">1</field>
        <field
            name="groups_id"
            eval="[(6, 0, [ref('sales_team.group_sale_salesman')])]"
        />
    </record>

    <!-- Form view: filter product_id to only show rental products -->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">rental_base_extension.view_order_form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="rental_base.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']//field[@name='product_id']"
                position="attributes"
            >
                <attribute name="domain">
                    [('sale_ok', '=', True),
                     ('rented_product_id', '!=', False),
                     '|', ('company_id', '=', False),
                          ('company_id', '=', parent.company_id)]
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
