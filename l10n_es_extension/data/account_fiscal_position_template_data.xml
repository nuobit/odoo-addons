        <field name="position_id" ref="l10n_es.fp_intra" />
        <field name="tax_src_id" ref="l10n_es.account_tax_template_p_iva4_nd" />
        <field name="tax_dest_id" ref="account_tax_template_p_iva4nd_sp_in" />
