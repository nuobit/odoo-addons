    <!-- Fiscal Position Tax Templates -->
    <!-- ************************************************************* -->
    <!-- Mapping lines that plug the non-deductible family into the
         official l10n_es fiscal positions, the same way
         l10n_es_special_prorate plugs its prorate taxes. Until
