<odoo>
    <template id="fields" inherit_id="auth_signup.signup" priority="100">
        <xpath expr="//button[@type='submit']/.." position="before">
            <t
                t-set="privacy_activity_opt_in"
                t-value="request.env['privacy.activity'].sudo().search([('is_opt_in', '=', True), ('consent_required', '!=', False)], limit=1)"
            />
            <t t-if="privacy_activity_opt_in">
                <div id="privacy_activity_opt_in">
                    <input
                        type="hidden"
                        id="opt_in_hidden"
                        name="opt_in"
                        value="declined"
                    />
                    <input
                        type="checkbox"
                        value="accepted"
                        id="opt_in"
                        onchange="document.getElementById('opt_in_hidden').value = this.checked ? 'accepted' : 'declined';"
                        class="s_website_form_input form-check-input"
                    />
                    <span
                        class="form-select-sm"
                    >I want to receive discounts, exclusive offers, and the latest news on products and services.</span>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
