<odoo>
    <record id="res_users_view_form" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[hasclass('oe_title')]/group/field[@name='partner_id']"
                position="before"
            >
                <field name="allow_update_partner" invisible="1" />
            </xpath>
            <xpath
                expr="//div[hasclass('oe_title')]/group/field[@name='partner_id']"
                position="attributes"
            >
                <attribute name="invisible">id == False</attribute>
                <attribute name="readonly">allow_update_partner == False</attribute>
            </xpath>
        </field>
    </record>
</odoo>
