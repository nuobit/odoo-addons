<odoo>
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <field name="slug_name" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="website_name" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="public_description" position="after">
                <field
                    name="variant_public_description"
                    string="Public Description"
                    widget="html"
                />
            </field>
            <field name="public_description" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="public_short_description" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="product_product_view_form_easy_inherit_website_sale" model="ir.ui.view">
        <field name="model">product.product</field>
        <field
            name="inherit_id"
            ref="website_sale_variant.product_product_view_form_easy_inherit_website_sale"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='shop']/group[@name='shop']/group"
                position="inside"
            >
                <field
                    name="variant_public_description"
                    string="Public Description"
                    widget="html"
                />
            </xpath>
        </field>
    </record>
</odoo>
