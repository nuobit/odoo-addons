<odoo>
    <template
        id="auth_signup_verify_email_phone.multi_auth_signup"
        name="Multi Authentication Signup"
    >
        <t t-call="web.login_layout">
            <div t-if="message" class="oe_login_form clearfix">
                <p class="alert alert-success" t-if="message" role="status">
                    <t t-esc="message" />
                </p>
                <a
                    href="/web/login"
                    class="btn btn-link btn-sm float-start"
                    role="button"
                >Back to Login</a>
            </div>
        </t>
    </template>
</odoo>
