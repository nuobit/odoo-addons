<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="image_1920" position="before">
                <group>
                    <div
                        style="display: flex; align-items: center; gap: 10px; font-size: 16px;"
                    >
                        AUTHENTICATION
                        <span
                            attrs="{'invisible': [('signup_email_validated', '=', True)]}"
                        >
                            <i
                                class="fa fa-envelope text-danger"
                                title="Email not verified"
                            />
                        </span>
                        <span
                            attrs="{'invisible': [('signup_email_validated', '=', False)]}"
                        >
                            <i
                                class="fa fa-envelope text-success"
                                title="Email verified"
                            />
                        </span>

                        <span
                            attrs="{'invisible': [('signup_mobile_validated', '=', True)]}"
                        >
                            <i
                                class="fa fa-phone text-danger"
                                title="Mobile not verified"
                            />
                        </span>
                        <span
                            attrs="{'invisible': [('signup_mobile_validated', '=', False)]}"
                        >
                            <i
                                class="fa fa-phone text-success"
                                title="Mobile verified"
                            />
                        </span>
                    </div>
                </group>
            </field>
            <xpath expr="//notebook" position="inside">
                <page name='signup_validation' string="Signup Validation">
                    <group>
                        <group>
                            <label for="signup_email_validated" />
                            <div class="o_row">
                                <field
                                    name="signup_email_validated"
                                    widget="boolean_toggle"
                                    class="oe_inline"
                                />
                                <button
                                    name="action_resend_email"
                                    type="object"
                                    class="btn-secondary oe_inline"
                                    string="Resend Email"
                                    attrs="{'invisible': [('signup_email_validated', '=', True)]}"
                                />
                            </div>
                            <label for="signup_mobile_validated" />
                            <div class="o_row">
                                <field
                                    name="signup_mobile_validated"
                                    widget="boolean_toggle"
                                    class="oe_inline"
                                />
                                <button
                                    name="action_resend_whatsapp"
                                    type="object"
                                    class="btn-secondary oe_inline"
                                    string="Resend Message"
                                    attrs="{'invisible': [('signup_mobile_validated', '=', True)]}"
                                />
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
