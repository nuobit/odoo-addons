<odoo>
    <record id="mail_whatsapp_template_view_form" model="ir.ui.view">
        <field name="name">mail.whatsapp.template.form.inherit</field>
        <field name="model">mail.whatsapp.template</field>
        <field
            name="inherit_id"
            ref="mail_gateway_whatsapp.view_mail_whatsapp_template_form"
        />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    type="object"
                    name="action_signup_auth"
                    class="oe_stat_button"
                    icon="fa-id-badge"
                    attrs="{'invisible': [('is_supported', '=', False)]}"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Use as authenticator for signup</span>
                        <span class="o_stat_value">
                            <field
                                name="signup_auth"
                                widget="boolean_toggle"
                                nolabel="1"
                                class="mr4"
                            />
                        </span>
                    </div>
                </button>
            </div>
        </field>
    </record>
    <record id="view_mail_whatsapp_template_tree" model="ir.ui.view">
        <field name="name">view.mail.whatsapp.template.tree.inherit</field>
        <field name="model">mail.whatsapp.template</field>
        <field
            name="inherit_id"
            ref="mail_gateway_whatsapp.view_mail_whatsapp_template_tree"
        />
        <field name="arch" type="xml">
            <tree position="inside">
                <field
                    name="signup_auth"
                    widget="boolean_toggle"
                    attrs="{'readonly': [('is_supported', '=', False)]}"
                />
            </tree>
        </field>
    </record>
</odoo>
