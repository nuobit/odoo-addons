<odoo>
    <template id="signup_fields" inherit_id="auth_signup.fields">
        <xpath expr="//div[@class='mb-3 field-login']" position="after">
            <div class="mb-3 field-mobile">
                <label for="name">Your Mobile</label>
                <input
                    type="text"
                    name="mobile"
                    t-att-value="mobile"
                    id="mobile"
                    class="form-control form-control-sm"
                    placeholder="+34600200500"
                    required="required"
                    t-att-readonly="'readonly' if only_passwords else None"
                />
            </div>
        </xpath>
        <xpath expr="//div[hasclass('field-confirm_password')]" position="after">
            <div class="mb-3 field-name">
                <label for="language">Preferred Language</label>
                <select name="language" class="form-control" required="True">
                    <t t-foreach="languages" t-as="lang" t-key="lang[0]">
                        <option
                            t-att-value="lang[0]"
                            t-att-selected="lang[0] == (language or request.env.context.get('lang', 'en_US'))"
                        ><t t-esc="lang[2].split('/').pop()" /></option>
                    </t>
                </select>
            </div>
        </xpath>
    </template>
</odoo>
