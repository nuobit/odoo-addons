<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="auth_signup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='enable_password_reset']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="max_resend_delay">
                    <div class="o_setting_left_pane" />
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Resend delay</span>
                        <div class="text-muted">
                            Time in hours to resend the email or phone verification code.
                        </div>
                        <div class="content-group" name="max_resend_delay_options">
                            <div class="d-flex">
                                <span>Email</span>
                                <field
                                    name="max_resend_delay_email"
                                    widget="float_time"
                                    class="ml8"
                                />
                            </div>
                            <div class="d-flex">
                                <span>Mobile</span>
                                <field
                                    name="max_resend_delay_email"
                                    widget="float_time"
                                    class="ml8"
                                />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="max_resend_count">
                    <div class="o_setting_left_pane" />
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Resend count</span>
                        <div class="text-muted">
                            Maximum number of resend attempts.
                        </div>
                        <div class="content-group" name="max_resend_count_options">
                            <div class="d-flex">
                                <span>Email</span>
                                <field name="max_resend_count_email" class="ml16" />
                            </div>
                            <div class="d-flex">
                                <span>Mobile</span>
                                <field name="max_resend_count_mobile" class="ml16" />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
