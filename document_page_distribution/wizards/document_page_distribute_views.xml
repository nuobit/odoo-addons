<odoo>
    <record id="document_page_distribute_form" model="ir.ui.view">
        <field name="name">document.page.distribute.form</field>
        <field name="model">document.page.distribute</field>
        <field name="arch" type="xml">
            <form string="Distribute Document">
                <div class="alert alert-info" role="alert">
                    The current version of the document will be distributed to the
                    selected recipients. The email content comes from the chosen
                    template and cannot be edited here.
                </div>
                <group>
                    <group>
                        <field name="document_page_id" />
                        <field name="history_id" force_save="1" />
                    </group>
                    <group>
                        <field name="template_id" options="{'no_create': True}" />
                    </group>
                </group>
                <field name="line_ids">
                    <tree editable="bottom" create="false" delete="false">
                        <field name="partner_id" force_save="1" />
                        <field
                            name="sendable"
                            invisible="1"
                            readonly="1"
                            force_save="1"
                        />
                        <field
                            name="selected"
                            widget="boolean_toggle"
                            attrs="{'readonly': [('sendable', '=', False)]}"
                        />
                        <field name="user_id" readonly="1" />
                        <field name="email" readonly="1" />
                        <field name="current_state" readonly="1" />
                    </tree>
                </field>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Send"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
