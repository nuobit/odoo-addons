<odoo>
    <record id="document_page_history_recipient_send_tree" model="ir.ui.view">
        <field name="name">document.page.history.recipient.send.tree</field>
        <field name="model">document.page.history.recipient.send</field>
        <field name="arch" type="xml">
            <tree
                create="false"
                import="false"
                export_xlsx="false"
                default_order="sent_date, id"
            >
                <field name="sent_date" />
                <field name="email" />
                <field name="template_id" />
                <field name="notification_status" />
                <field name="sent_by" />
            </tree>
        </field>
    </record>
    <record id="document_page_history_recipient_send_form" model="ir.ui.view">
        <field name="name">document.page.history.recipient.send.form</field>
        <field name="model">document.page.history.recipient.send</field>
        <field name="arch" type="xml">
            <form string="Send">
                <sheet>
                    <group>
                        <group>
                            <field name="sent_date" />
                            <field name="sent_by" />
                            <field name="email" />
                            <field name="template_id" />
                        </group>
                        <group>
                            <field name="notification_status" />
                            <field name="mail_message_id" />
                            <field name="mail_notification_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
