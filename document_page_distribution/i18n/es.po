#. module: document_page_distribution
#: model:mail.template,body_html:document_page_distribution.mail_template_document_page_distribution
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Hello,<br/><br/>\n"
"                    The current version of the document\n"
"                    <strong>${object.name}</strong>\n"
"                    has been distributed to you.\n"
"                </p>\n"
"                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 16px 0px; background-color: #F8FAFC; border-collapse: separate;\">\n"
"                    <tr>\n"
"                        <td style=\"padding: 12px 16px; border-left: 4px solid #875A7B; font-size: 13px;\">\n"
"                            Version:\n"
"                            <strong>${object.draft_name or 'current version'}</strong><br/>\n"
"                            Change summary:\n"
"                            ${object.draft_summary or '-'}\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"                <div style=\"margin: 16px 0px;\">\n"
"                    <a href=\"${object.get_base_url()}/web#id=${object.id}&amp;model=document.page&amp;view_type=form\" style=\"background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #FFFFFF; border-radius: 5px; font-size: 13px;\">Open the document page</a>\n"
"                </div>\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    This notice is sent to the users with read access to the\n"
"                    document and is recorded in the document's communication\n"
"                    history.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Hola,<br/><br/>\n"
"                    Se ha distribuido la versión actual del documento\n"
"                    <strong>${object.name}</strong>.\n"
"                </p>\n"
"                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 16px 0px; background-color: #F8FAFC; border-collapse: separate;\">\n"
"                    <tr>\n"
"                        <td style=\"padding: 12px 16px; border-left: 4px solid #875A7B; font-size: 13px;\">\n"
"                            Versión:\n"
"                            <strong>${object.draft_name or 'versión actual'}</strong><br/>\n"
"                            Resumen del cambio:\n"
"                            ${object.draft_summary or '-'}\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"                <div style=\"margin: 16px 0px;\">\n"
"                    <a href=\"${object.get_base_url()}/web#id=${object.id}&amp;model=document.page&amp;view_type=form\" style=\"background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #FFFFFF; border-radius: 5px; font-size: 13px;\">Abrir la página del documento</a>\n"
"                </div>\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Este aviso se envía a los usuarios con acceso de lectura al\n"
"                    documento y queda registrado en el historial de\n"
"                    comunicaciones del documento.\n"
"                </p>\n"
"            </div>\n"
"        "

