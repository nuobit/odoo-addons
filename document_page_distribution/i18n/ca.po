msgid ""
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: #F1F1F1; font-family: Verdana, Arial, sans-serif; color: #454748; width: 100%; border-collapse: separate;\">\n"
"                <tr>\n"
"                    <td align=\"center\">\n"
"                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"padding: 16px; background-color: #FFFFFF; color: #454748; border-collapse: separate;\">\n"
"                            <tbody>\n"
"                                <!-- HEADER -->\n"
"                                <tr>\n"
"                                    <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: #FFFFFF; padding: 0px 8px; border-collapse: separate;\">\n"
"                                            <tr>\n"
"                                                <td valign=\"middle\">\n"
"                                                    <span style=\"font-size: 10px;\">Document Management</span><br/>\n"
"                                                    <span style=\"font-size: 20px; font-weight: bold;\">${object.name}</span>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                            <tr>\n"
"                                                <td colspan=\"2\" style=\"text-align: center;\">\n"
"                                                    <hr width=\"100%\" style=\"background-color: #CCCCCC; border: medium none; clear: both; display: block; font-size: 0px; min-height: 1px; line-height: 0; margin: 16px 0px;\"/>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                        </table>\n"
"                                    </td>\n"
"                                </tr>\n"
"                                <!-- CONTENT -->\n"
"                                <tr>\n"
"                                    <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: #FFFFFF; padding: 0px 8px; border-collapse: separate;\">\n"
"                                            <tr>\n"
"                                                <td valign=\"top\" style=\"font-size: 13px;\">\n"
"                                                    Hello,<br/><br/>\n"
"                                                    A new version of the document\n"
"                                                    <strong>${object.name}</strong>\n"
"                                                    has been published in the\n"
"                                                    document management system.\n"
"                                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 16px 0px; background-color: #F8FAFC; border-collapse: separate;\">\n"
"                                                        <tr>\n"
"                                                            <td style=\"padding: 12px 16px; border-left: 4px solid #875A7B; font-size: 13px;\">\n"
"                                                                Version:\n"
"                                                                <strong>${object.draft_name or 'latest version'}</strong><br/>\n"
"                                                                Change summary:\n"
"                                                                ${object.draft_summary or '-'}\n"
"                                                            </td>\n"
"                                                        </tr>\n"
"                                                    </table>\n"
"                                                    <div style=\"margin: 16px 0px;\">\n"
"                                                        <a href=\"${object.get_base_url()}/web#id=${object.id}&amp;model=document.page&amp;view_type=form\" style=\"background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #FFFFFF; border-radius: 5px; font-size: 13px;\">Open the document page</a>\n"
"                                                    </div>\n"
"                                                    This notice is sent to the\n"
"                                                    users with read access to the\n"
"                                                    document and is recorded in\n"
"                                                    the document's communication\n"
"                                                    history.\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                            <tr>\n"
"                                                <td style=\"text-align: center;\">\n"
"                                                    <hr width=\"100%\" style=\"background-color: #CCCCCC; border: medium none; clear: both; display: block; font-size: 0px; min-height: 1px; line-height: 0; margin: 16px 0px;\"/>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                        </table>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </tbody>\n"
"                        </table>\n"
"                    </td>\n"
"                </tr>\n"
"            </table>\n"
"        "
