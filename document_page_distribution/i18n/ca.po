#, python-format
msgid ""
"The distribution log does not know the delivery status '%(status)s' of the "
"send to %(email)s. Please contact your administrator."
msgstr ""
"El registre de distribució no coneix l'estat de lliurament '%(status)s' de "
"l'enviament a %(email)s. Contacta amb l'administrador."

#. module: document_page_distribution
#: model:ir.model.fields,help:document_page_distribution.field_document_page_history_recipient__has_access
msgid "The user could read the document when the distribution was confirmed."
msgstr ""
"L'usuari podia llegir el document quan es va confirmar la distribució."

#. module: document_page_distribution
#: code:addons/document_page_distribution/models/document_page.py:0
#, python-format
msgid ""
"There is no recipient to send the document to. Select at least one recipient"
" with access to the document and an email address."
msgstr ""
"No hi ha cap destinatari a qui enviar el document. Selecciona almenys un "
"destinatari amb accés al document i adreça de correu electrònic."

