"                                                            </td>\n"
"                                                        </tr>\n"
"                                                    </table>\n"
"                                                    <div style=\"margin: 16px 0px;\">\n"
"                                                        <a href=\"${object.get_base_url()}/web#id=${object.id}&amp;model=document.page&amp;view_type=form\" style=\"background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #FFFFFF; border-radius: 5px; font-size: 13px;\">Obre la pàgina del document</a>\n"
"                                                    </div>\n"
"                                                    Aquest avís s'envia als usuaris amb accés de lectura al document i queda registrat a l'historial de comunicacions del document.\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                            <tr>\n"
"                                                <td style=\"text-align: center;\">\n"
"                                                    <hr width=\"100%\" style=\"background-color: #CCCCCC; border: medium none; clear: both; display: block; font-size: 0px; min-height: 1px; line-height: 0; margin: 16px 0px;\"/>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                        </table>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </tbody>\n"
"                        </table>\n"
"                    </td>\n"
"                </tr>\n"
"            </table>\n"
"        "

