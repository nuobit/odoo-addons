<odoo noupdate="1">
    <record id="mail_template_document_page_distribution" model="mail.template">
        <field name="name">Document Page: Distribution</field>
        <field name="model_id" ref="document_page.model_document_page" />
        <field
            name="subject"
        >Document distribution: ${object.name} (${object.draft_name or 'current version'})</field>
        <field
            name="email_from"
        >"${(object.company_id or user.company_id).name | safe}" &lt;${((object.company_id or user.company_id).email or user.email) | safe}&gt;</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px; font-size: 13px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hello,<br /><br />
                    The current version of the document
                    <strong>${object.name}</strong>
                    has been distributed to you.
                </p>
                <table
                    border="0"
                    cellpadding="0"
                    cellspacing="0"
                    width="100%"
                    style="margin: 16px 0px; background-color: #F8FAFC; border-collapse: separate;"
                >
                    <tr>
                        <td
                            style="padding: 12px 16px; border-left: 4px solid #875A7B; font-size: 13px;"
                        >
                            Version:
                            <strong
                            >${object.draft_name or 'current version'}</strong><br />
                            Change summary:
                            ${object.draft_summary or '-'}
                        </td>
                    </tr>
                </table>
                <div style="margin: 16px 0px;">
                    <a
                        href="${object.get_base_url()}/web#id=${object.id}&amp;model=document.page&amp;view_type=form"
                        style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #FFFFFF; border-radius: 5px; font-size: 13px;"
                    >Open the document page</a>
                </div>
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    This notice is sent to the users with read access to the
                    document and is recorded in the document's communication
                    history.
                </p>
            </div>
        </field>
    </record>
</odoo>
