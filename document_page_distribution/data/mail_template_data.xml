<odoo noupdate="1">
    <record id="mail_template_document_page_distribution" model="mail.template">
        <field name="name">Document Page: Distribution</field>
        <field name="model_id" ref="document_page.model_document_page" />
        <field
            name="subject"
        >New document version available: ${object.name} (${object.draft_name or 'latest version'})</field>
        <field
            name="email_from"
        >"${object.company_id.name | safe}" &lt;${(object.company_id.email or user.email) | safe}&gt;</field>
        <field name="body_html" type="html">
            <table
                border="0"
                cellpadding="0"
                cellspacing="0"
                style="padding-top: 16px; background-color: #F1F1F1; font-family: Verdana, Arial, sans-serif; color: #454748; width: 100%; border-collapse: separate;"
            >
                <tr>
                    <td align="center">
                        <table
                            border="0"
                            cellpadding="0"
                            cellspacing="0"
                            width="590"
                            style="padding: 16px; background-color: #FFFFFF; color: #454748; border-collapse: separate;"
                        >
                            <tbody>
                                <!-- HEADER -->
                                <tr>
                                    <td align="center" style="min-width: 590px;">
                                        <table
                                            border="0"
                                            cellpadding="0"
                                            cellspacing="0"
                                            width="590"
                                            style="min-width: 590px; background-color: #FFFFFF; padding: 0px 8px; border-collapse: separate;"
                                        >
                                            <tr>
                                                <td valign="middle">
                                                    <span
                                                        style="font-size: 10px;"
                                                    >Document Management</span><br />
                                                    <span
                                                        style="font-size: 20px; font-weight: bold;"
                                                    >${object.name}</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td
                                                    colspan="2"
                                                    style="text-align: center;"
                                                >
                                                    <hr
                                                        width="100%"
                                                        style="background-color: #CCCCCC; border: medium none; clear: both; display: block; font-size: 0px; min-height: 1px; line-height: 0; margin: 16px 0px;"
                                                    />
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                <!-- CONTENT -->
                                <tr>
                                    <td align="center" style="min-width: 590px;">
                                        <table
                                            border="0"
                                            cellpadding="0"
                                            cellspacing="0"
                                            width="590"
                                            style="min-width: 590px; background-color: #FFFFFF; padding: 0px 8px; border-collapse: separate;"
                                        >
                                            <tr>
                                                <td
                                                    valign="top"
                                                    style="font-size: 13px;"
                                                >
                                                    Hello,<br /><br />
                                                    A new version of the document
                                                    <strong>${object.name}</strong>
                                                    has been published in the
                                                    document management system.
                                                    <table
                                                        border="0"
                                                        cellpadding="0"
                                                        cellspacing="0"
                                                        width="100%"
                                                        style="margin: 16px 0px; background-color: #F8FAFC; border-collapse: separate;"
                                                    >
                                                        <tr>
                                                            <td
                                                                style="padding: 12px 16px; border-left: 4px solid #875A7B; font-size: 13px;"
                                                            >
                                                                Version:
                                                                <strong
                                                                >${object.draft_name or 'latest version'}</strong><br
                                                                />
                                                                Change summary:
                                                                ${object.draft_summary or '-'}
                                                            </td>
                                                        </tr>
                                                    </table>
                                                    <div style="margin: 16px 0px;">
                                                        <a
                                                            href="${object.get_base_url()}/web#id=${object.id}&amp;model=document.page&amp;view_type=form"
                                                            style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #FFFFFF; border-radius: 5px; font-size: 13px;"
                                                        >Open the document page</a>
                                                    </div>
                                                    This notice is sent to the
                                                    users with read access to the
                                                    document and is recorded in
                                                    the document's communication
                                                    history.
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="text-align: center;">
                                                    <hr
                                                        width="100%"
                                                        style="background-color: #CCCCCC; border: medium none; clear: both; display: block; font-size: 0px; min-height: 1px; line-height: 0; margin: 16px 0px;"
                                                    />
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </table>
        </field>
    </record>
</odoo>
