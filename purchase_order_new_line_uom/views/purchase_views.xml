<odoo>
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.new.line.uom</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/list/field[@name='invoice_lines']"
                position="after"
            >
                <field
                    name="invoice_lines"
                    column_invisible="1"
                    widget="many2many_tags"
                />
                <field name="move_ids" column_invisible="1" widget="many2many_tags" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list/field[@name='product_uom']"
                position="attributes"
            >
                <attribute
                    name="readonly"
                >state in ('purchase', 'done', 'cancel') and (invoice_lines != [] or move_ids != []) or is_downpayment </attribute>
            </xpath>
        </field>
    </record>
</odoo>
