<odoo>
    <record id="stock_picking_type_view_form" model="ir.ui.view">
        <field name="name">stock.picking.type.view.form.inherit</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']/.." position="inside">
                <field
                    name="use_in_location_moves"
                    attrs='{"invisible": [("code", "not in", ["internal"])]}'
                />
            </xpath>
        </field>
    </record>
</odoo>
