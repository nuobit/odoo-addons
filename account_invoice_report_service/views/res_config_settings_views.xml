<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="after">
                <block title="Services Invoices" id="services_invoices_settings">
                    <setting
                        id="weight_uom_setting"
                        company_dependent="1"
                        string="Default report for Services Invoices"
                        help="If empty, you're gonna need to select a template on batch processing dialog."
                    >
                        <field name="report_service_id" class="o_light_label" />
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
