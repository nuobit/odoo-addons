#. module: document_page_editable_file
#: code:addons/document_page_editable_file/models/ir_attachment.py:0
#, python-format
msgid ""
"The attachment of an editable file cannot be changed directly: change the "
"file on the Editables tab of its version, while its files can change."
msgstr ""
"L'adjunt d'un fitxer editable no es pot canviar directament: canvia el "
"fitxer a la pestanya Editables de la seva versió, mentre els seus fitxers "
"puguin canviar."

#. module: document_page_editable_file
#: code:addons/document_page_editable_file/models/document_page_editable_file.py:0
#, python-format
msgid "The editable file \"%s\" has no file: every editable file needs one."
msgstr ""
"El fitxer editable \"%s\" no té fitxer: cada fitxer editable en necessita "
"un."

#. module: document_page_editable_file
#: code:addons/document_page_editable_file/models/document_page_history.py:0
#, python-format
msgid ""
"The editable files of \"%s\" cannot change: only those of the version its "
"document shows can."
msgstr ""
"Els fitxers editables de \"%s\" no poden canviar: només poden canviar els de"
" la versió que mostra el seu document."

#. module: document_page_editable_file
#: model:ir.model.fields,help:document_page_editable_file.field_document_page_history__editables_locked
msgid "The editable files of this version can no longer change."
msgstr "Els fitxers editables d'aquesta versió ja no poden canviar."

#. module: document_page_editable_file
#: model:ir.model.fields,help:document_page_editable_file.field_document_page__editables_locked
msgid "The editable files this document shows can no longer change."
msgstr "Els fitxers editables que mostra aquest document ja no poden canviar."

