#. module: document_page_editable_file
#: code:addons/document_page_editable_file/models/ir_attachment.py:0
#, python-format
msgid ""
"The attachment of an editable file cannot be changed or shared directly: to "
"change the file, use the Editables tab of its document or of its version, "
"while its files can change."
msgstr ""
"El adjunto de un archivo editable no se puede cambiar ni compartir "
"directamente: para cambiar el archivo, usa la pestaña Editables de su "
"documento o de su versión, mientras sus archivos puedan cambiar."

#. module: document_page_editable_file
#: code:addons/document_page_editable_file/models/document_page_editable_file.py:0
#, python-format
msgid "The editable file \"%s\" has no file: every editable file needs one."
msgstr ""
"El archivo editable \"%s\" no tiene archivo: cada archivo editable necesita "
"uno."

#. module: document_page_editable_file
#: code:addons/document_page_editable_file/models/document_page_history.py:0
#, python-format
msgid ""
"The editable files of \"%s\" cannot change: only those of the version its "
"document shows can."
msgstr ""
"Los archivos editables de \"%s\" no pueden cambiar: solo pueden cambiar los "
"de la versión que muestra su documento."

#. module: document_page_editable_file
#: model:ir.model.fields,help:document_page_editable_file.field_document_page_history__editables_locked
msgid "The editable files of this version can no longer change."
msgstr "Los archivos editables de esta versión ya no pueden cambiar."

#. module: document_page_editable_file
