<odoo>
    <record id="view_wiki_form" model="ir.ui.view">
        <field name="name">document.page.form.inherit.editable.file</field>
        <field name="model">document.page</field>
        <field name="inherit_id" ref="document_page.view_wiki_form" />
        <field
            name="groups_id"
            eval="[(6, 0, [ref('document_page.group_document_editor')])]"
        />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='history']" position="after">
                <!-- A category keeps no versions, so no editable files either -->
                <page
                    name="editable_files"
                    string="Editables"
                    attrs="{'invisible': [('type', '!=', 'content')]}"
                >
                    <field name="editables_locked" invisible="1" />
                    <field
                        name="editable_file_ids"
                        attrs="{'readonly': [('editables_locked', '=', True)]}"
                    >
                        <tree editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                            <field name="file" filename="name" widget="binary" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
