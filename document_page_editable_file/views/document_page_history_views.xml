<odoo>
    <record id="wiki_history_form" model="ir.ui.view">
        <field name="name">document.page.history.form.inherit.editable.file</field>
        <field name="model">document.page.history</field>
        <field name="inherit_id" ref="document_page.wiki_history_form" />
        <!-- Above the default priority, so that the tab goes after the one that
             document_page_distribution adds, which this module does not depend on -->
        <field name="priority">17</field>
        <field
            name="groups_id"
            eval="[(6, 0, [ref('group_document_editable_file'), ref('document_page.group_document_manager')])]"
        />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="editable_files" string="Editables">
                    <field
                        name="editable_content"
                        widget="html"
                        options="{'safe': True}"
                    />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
