<odoo>
    <!-- The rule that document_page puts on the versions, for their files -->
    <record id="document_page_editable_file_rule_company" model="ir.rule">
        <field name="name">document.page.editable.file multi-company</field>
        <field name="model_id" ref="model_document_page_editable_file" />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|',('history_id.company_id','=',False),('history_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
