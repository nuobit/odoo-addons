<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <xpath
            expr="//div[@name='signature']//p[@t-field='o.partner_id.name']"
            position="attributes"
        >
            <attribute name="t-if">not o.signed_by</attribute>
        </xpath>
        <xpath
            expr="//div[@name='signature']//p[@t-field='o.partner_id.name']"
            position="after"
        >
            <p t-if="o.signed_by" t-field="o.signed_by" />
        </xpath>
    </template>
</odoo>
