<odoo>
    <record id="view_order_form_spms_button" model="ir.ui.view">
        <field name="name">sale.order.form.spms.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/tree//field[@name='price_subtotal']"
                position="after"
            >
                <button
                    name="action_view_spms_sale_order_line"
                    type="object"
                    icon="fa-eye"
                    class="btn-primary"
                />
            </xpath>
        </field>
    </record>
</odoo>
