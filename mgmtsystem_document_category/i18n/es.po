#. module: mgmtsystem_document_category
#: model:ir.model.fields,help:mgmtsystem_document_category.field_document_page__mgmtsystem_category_type
msgid ""
"Management system classification of this document category. Documents stored"
" under a classified category become available in the related management "
"system fields (e.g. nonconformity procedures), regardless of the category "
"name or language."
msgstr ""
"Clasificación del sistema de gestión de esta categoría de documentos. Los "
"documentos almacenados bajo una categoría clasificada quedan disponibles en "
"los campos del sistema de gestión relacionados (p. ej. los procedimientos de"
" no conformidad), independientemente del nombre o el idioma de la categoría."

