#. module: mail_dictation_openai
#: model_terms:ir.ui.view,arch_db:mail_dictation_openai.res_config_settings_view_form
msgid "Address"
msgstr "Dirección"

#. module: mail_dictation_openai
#: model:ir.model.fields,help:mail_dictation_openai.field_res_config_settings__mail_dictation_address
msgid ""
"Address of the OpenAI-compatible transcription API: the voice is sent to "
"this address followed by /audio/transcriptions."
msgstr ""
"Dirección de la API de transcripción compatible con OpenAI: la voz se envía "
"a esta dirección seguida de /audio/transcriptions."

#. module: mail_dictation_openai
#: model:ir.model,name:mail_dictation_openai.model_res_config_settings
msgid "Config Settings"
msgstr "Ajustes de configuración"

#. module: mail_dictation_openai
#: model:ir.model.fields,field_description:mail_dictation_openai.field_res_config_settings__mail_dictation_model
msgid "Dictation Model"
msgstr "Modelo de dictado"

#. module: mail_dictation_openai
#: model:ir.model.fields,field_description:mail_dictation_openai.field_res_config_settings__mail_dictation_address
msgid "Dictation Service Address"
msgstr "Dirección del servicio de dictado"

#. module: mail_dictation_openai
#: model:ir.model.fields,field_description:mail_dictation_openai.field_res_config_settings__mail_dictation_api_key
msgid "Dictation Service Key"
msgstr "Clave del servicio de dictado"

#. module: mail_dictation_openai
#. odoo-python
#: code:addons/mail_dictation_openai/models/mail_dictation_openai.py:0
#, python-format
msgid ""
"Dictation is not configured: an administrator must enter the transcription "
"service key in Settings > Discuss."
msgstr ""
"El dictado no está configurado: un administrador debe introducir la clave "
"del servicio de transcripción en Ajustes > Conversaciones."

#. module: mail_dictation_openai
#: model:ir.model,name:mail_dictation_openai.model_mail_dictation_openai
msgid "Dictation through an OpenAI-compatible service"
msgstr "Dictado con un servicio compatible con OpenAI"

#. module: mail_dictation_openai
#: model_terms:ir.ui.view,arch_db:mail_dictation_openai.res_config_settings_view_form
msgid "Key"
msgstr "Clave"

#. module: mail_dictation_openai
#: model:ir.model.fields,help:mail_dictation_openai.field_res_config_settings__mail_dictation_api_key
msgid "Key of the transcription service, sent as a bearer token."
msgstr "Clave del servicio de transcripción, enviada como token Bearer."

#. module: mail_dictation_openai
#: model_terms:ir.ui.view,arch_db:mail_dictation_openai.res_config_settings_view_form
msgid "Model"
msgstr "Modelo"

#. module: mail_dictation_openai
#: model:ir.model.fields.selection,name:mail_dictation_openai.selection__res_config_settings__mail_dictation_provider__openai
msgid "OpenAI-compatible service"
msgstr "Servicio compatible con OpenAI"

#. module: mail_dictation_openai
#: model:ir.model.fields,help:mail_dictation_openai.field_res_config_settings__mail_dictation_provider
msgid "Service that turns the dictated voice into text."
msgstr "Servicio que convierte la voz dictada en texto."

#. module: mail_dictation_openai
#. odoo-python
#: code:addons/mail_dictation_openai/models/mail_dictation_openai.py:0
#, python-format
msgid ""
"The dictation quota is used up: an administrator must add credit or raise "
"the spending limit at the transcription service."
msgstr ""
"La cuota de dictado se ha agotado: un administrador debe añadir crédito o "
"aumentar el límite de gasto en el servicio de transcripción."

#. module: mail_dictation_openai
#. odoo-python
#: code:addons/mail_dictation_openai/models/mail_dictation_openai.py:0
#, python-format
msgid "The transcription service could not be reached. Try again in a moment."
msgstr ""
"No se ha podido conectar con el servicio de transcripción. Vuelva a "
"intentarlo en un momento."

#. module: mail_dictation_openai
#. odoo-python
#: code:addons/mail_dictation_openai/models/mail_dictation_openai.py:0
#, python-format
msgid "The transcription service failed. Try again in a moment."
msgstr ""
"El servicio de transcripción ha fallado. Vuelva a intentarlo en un momento."

#. module: mail_dictation_openai
#. odoo-python
#: code:addons/mail_dictation_openai/models/mail_dictation_openai.py:0
#, python-format
msgid "The transcription service is busy. Try again in a moment."
msgstr ""
"El servicio de transcripción está saturado. Vuelva a intentarlo en un "
"momento."

#. module: mail_dictation_openai
#. odoo-python
#: code:addons/mail_dictation_openai/models/mail_dictation_openai.py:0
#, python-format
msgid ""
"The transcription service refused the key: an administrator must check it in"
" Settings > Discuss."
msgstr ""
"El servicio de transcripción ha rechazado la clave: un administrador debe "
"revisarla en Ajustes > Conversaciones."

#. module: mail_dictation_openai
#: model:ir.model.fields,field_description:mail_dictation_openai.field_res_config_settings__mail_dictation_provider
msgid "Transcription Service"
msgstr "Servicio de transcripción"

#. module: mail_dictation_openai
#: model:ir.model.fields,help:mail_dictation_openai.field_res_config_settings__mail_dictation_model
msgid "Transcription model of the service that turns the voice into text."
msgstr "Modelo de transcripción del servicio que convierte la voz en texto."
